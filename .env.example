PORT=3000

# Local dev DB — matches docker-compose.yml's `db` service. Host port 5433 (not the default 5432)
# to avoid clashing with any other local Postgres instance.
DATABASE_URL=postgres://app:app@localhost:5433/orders

# Used only by the integration test suite (tests/setupEnv.ts overrides DATABASE_URL with this
# before any test file loads). Separate database, same Postgres instance — tests never touch
# dev data. Created automatically by docker/init-test-db.sh on first `docker compose up`.
TEST_DATABASE_URL=postgres://app:app@localhost:5433/orders_test
