PORT=3000

# Local dev DB — matches docker-compose.yml's `db` service. Host port 5433 (not the default 5432)
# to avoid clashing with any other local Postgres instance.
DATABASE_URL=postgres://app:app@localhost:5433/orders

# Used only by the integration test suite (tests/setupEnv.ts overrides DATABASE_URL with this
# before any test file loads). Separate database, same Postgres instance — tests never touch
# dev data. Created automatically by docker/init-test-db.sh on first `docker compose up`.
TEST_DATABASE_URL=postgres://app:app@localhost:5433/orders_test

# Production readiness (ticket 17) — all optional, shown here with their defaults.
NODE_ENV=development
LOG_LEVEL=info

# Connection-pool sizing and timeouts.
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
# Server-enforced per-query timeout (Postgres aborts any single statement that runs longer).
DB_STATEMENT_TIMEOUT_MS=10000

# HTTP server timeouts. HEADERS_TIMEOUT_MS must stay greater than REQUEST_TIMEOUT_MS (Node
# requirement).
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=31000

# How long graceful shutdown waits for in-flight requests and the DB pool to close before
# force-exiting.
SHUTDOWN_TIMEOUT_MS=10000
